# ── Backend environment ──────────────────────────────────────
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
# Generate a strong JWT secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

NODE_ENV=development
PORT=4000

# Required — signs access tokens. Must be at least 16 characters.
# NEVER commit the real value.
JWT_SECRET=change-me-to-a-long-random-secret

# SQLite database file (dev, zero-config default).
DB_STORAGE=./data.sqlite

# ── PostgreSQL (optional — the V2 target) ─────────────────────
# Start the local database:  docker compose up -d db   (repo root)
# Then switch this backend to PostgreSQL:
#   DB_DIALECT=postgres
#   DATABASE_URL=postgres://oms:oms@localhost:5432/oms
# …or use discrete variables instead of DATABASE_URL:
#   DB_HOST=localhost
#   DB_PORT=5432
#   DB_NAME=oms
#   DB_USER=oms
#   DB_PASSWORD=oms
# Set DB_SSL=1 when connecting to a managed provider over TLS.
# Schema on PostgreSQL is managed by the migration runner:
#   npm run db:migrate && npm run db:migrate:status
#   npm run db:migrate:down            # roll back the last migration

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Public base URL used in email links (verification, password reset).
APP_BASE_URL=http://localhost:5173

# Set to 1 when running behind a reverse proxy (affects rate-limit IPs).
TRUST_PROXY=0

# ── Media / object storage (Phase 4 image pipeline) ────────────────────
# local (default) writes to UPLOAD_DIR and serves via /uploads — zero-config
# for development. s3 uses any S3-compatible bucket (AWS, MinIO, R2…).
# STORAGE_DRIVER=s3
# S3_BUCKET=my-oms-media
# S3_REGION=ap-southeast-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=                 # e.g. https://minio.example.com (MinIO/R2)
# S3_FORCE_PATH_STYLE=1        # required by MinIO-style endpoints
# CDN_BASE_URL=                # public image base, e.g. https://cdn.example.com

# Upload limits (bytes).
# MAX_IMAGE_BYTES=5242880      # 5 MB
# MAX_IMAGE_DIMENSION=4096     # px
# MAX_IMPORT_BYTES=2097152     # 2 MB (bulk CSV import)
# MAX_IMPORT_ROWS=2000         # max rows per import

# ── Online payments (Phase 5 gateway integration) ──────────────────────
# Empty/unset = online orders fail with a clear PAYMENT_GATEWAY_NOT_CONFIGURED
# error; set the provider + its credentials to enable hosted checkout.
# PAYMENT_GATEWAY=sslcommerz   # or stripe (currently the only two)
# SSLCOMMERZ_STORE_ID=
# SSLCOMMERZ_STORE_PASSWORD=
# SSLCOMMERZ_SANDBOX=1
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
