    "sequelize": "^6.37.1",
    "sqlite3": "^6.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "globals": "^15.9.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0",
    "vitest": "^4.1.10"
