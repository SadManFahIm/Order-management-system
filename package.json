{
  "name": "order-management-system",
  "version": "2.0.0",
  "private": true,
  "description": "Orderly — multi-tenant restaurant order management SaaS (backend + frontend monorepo)",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "seed:demo": "node scripts/seed-demo.mjs",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:migrate:status": "npm --prefix backend run db:migrate:status",
    "test:backend": "npm --prefix backend test",
    "test:e2e": "npm --prefix frontend run test:e2e"
  },
  "engines": {
    "node": ">=18"
  }
}
