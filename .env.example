# ── docker-compose environment ───────────────────────────────
# Copy this file to `.env` in the repo root and fill in real values:
#   cp .env.example .env
# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# Required — used to sign access tokens. MUST be at least 16 characters.
JWT_SECRET=generate-a-long-random-secret

# Comma-separated list of allowed CORS origins for the API.
CORS_ORIGINS=http://localhost:5173

# ── Optional: PostgreSQL (V2) ──────────────────────────────────
# The `db` service in docker-compose.yml defaults to oms/oms@localhost:5432
# (database `oms`). Override any of these to match your local PostgreSQL.
# The backend service then connects via DATABASE_URL built from them.
# DB_USER=oms
# DB_PASSWORD=oms
# DB_NAME=oms
# DB_PORT=5432
